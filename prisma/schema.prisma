generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String?         @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              String          @default("CUSTOMER") // ADMIN | SUPPORT | DESIGNER | CUSTOMER
  firstName         String
  lastName          String
  preferredLanguage String          @default("es") // es, cat
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orders            Order[]
  checkoutGroups    CheckoutGroup[]
  carts             Cart[]
  seller            Seller?
  address           UserAddress?
}

model UserAddress {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street            String?
  houseNumber       String?
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  city              String?
  county            String?
  state             String?
  country           String?
  countryCode       String?
  formattedAddress  String?
  floor             String?
  door              String?
  stairway          String?
  block             String?
  instructions      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String @default("")
}

model Seller {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("active")
  deletedAt   DateTime?
  products    Product[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Product {
  id                  String               @id @default(cuid())
  basePrice           Decimal
  currency            String               @default("EUR")
  sellerId            String
  seller              Seller               @relation(fields: [sellerId], references: [id])
  status              String               @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id])
  customizationConfig Json?
  images              ProductImage[]
  tags                Tag[]                @relation("ProductTags")
  translations        ProductTranslation[]
  customizations      Customization[]
  lineItems           OrderLineItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
}

model ProductTranslation {
  id          String  @id @default(cuid())
  locale      String // es, cat
  name        String
  description String?
  tags        String[] @default([])
  sizes       String[] @default([])
  designChangeDescription String?
  photoLabels Json?

  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([name])
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String
  term       String
  locale     String
  searchedAt DateTime @default(now())

  @@unique([userId, term, locale])
  @@index([userId, locale, searchedAt(sort: Desc)])
}

model Customization {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  text           String?
  color          String?
  size           String?
  imageUrl       String?
  /// Buyer-side design position captured by the mockup canvas.
  /// Stored as JSONB so we can preserve the full shape (x, y, scale,
  /// rotation_deg, opacity, blend_mode, imageUrl) without a wide row.
  /// Nullable — older rows and text-only customizations have no design.
  designPosition Json?
  createdAt      DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  sellerId        String
  seller          Seller          @relation(fields: [sellerId], references: [id])
  checkoutGroupId String?
  checkoutGroup   CheckoutGroup?  @relation(fields: [checkoutGroupId], references: [id])
  status          String          @default("PENDING")
  total           Decimal
  // Source cart id when the order was created by HandleCartCheckedOut
  // (spec REQ-ORD-001). Used for idempotency: the handler dedupes by
  // cartId so duplicate CART_CHECKED_OUT deliveries do not create a
  // second set of orders. Null for orders not created from a cart.
  cartId          String?
  lineItems       OrderLineItem[]
  deliveryStreet           String?
  deliveryHouseNumber      String?
  deliveryAddressLine1     String?
  deliveryAddressLine2     String?
  deliveryPostalCode       String?
  deliveryCity             String?
  deliveryCounty           String?
  deliveryState            String?
  deliveryCountry          String?
  deliveryCountryCode      String?
  deliveryFormattedAddress String?
  deliveryFloor            String?
  deliveryDoor             String?
  deliveryStairway         String?
  deliveryBlock            String?
  deliveryInstructions     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([checkoutGroupId, sellerId])
  @@unique([cartId, sellerId])
  @@index([checkoutGroupId])
  @@index([cartId])
}

model CheckoutGroup {
  id                  String                        @id @default(cuid())
  userId              String
  user                User                          @relation(fields: [userId], references: [id])
  currency            String                        @default("EUR")
  totalAmount         Decimal
  paymentStatus       String                        @default("PENDING")
  paymentAttemptCount Int                           @default(0)
  latestPaymentId     String?
  orders              Order[]
  paymentAttempts     CheckoutGroupPaymentAttempt[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([userId, paymentStatus])
}

model CheckoutGroupPaymentAttempt {
  id              String        @id @default(cuid())
  checkoutGroupId String
  checkoutGroup   CheckoutGroup @relation(fields: [checkoutGroupId], references: [id], onDelete: Cascade)
  paymentId       String?
  amount          Decimal
  currency        String        @default("EUR")
  status          String
  failureReason   String?
  createdAt       DateTime      @default(now())

  @@index([checkoutGroupId, createdAt])
}

model OrderLineItem {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id])
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  quantity              Int
  unitPrice             Decimal  @default(0)
  productImageUrl       String?
  customizationIdList   String[] @default([])
  customizationSnapshot Json?
  createdAt             DateTime @default(now())
}

model SignupAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  email     String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model EmailQueue {
  id          String    @id @default(cuid())
  to          String
  subject     String
  htmlBody    String
  template    String?
  metadata    Json?
  idempotencyKey String @unique
  status      String    @default("PENDING")
  error       String?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  // PENDING, PROCESSED, FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  position  Int
  purpose   ProductImagePurpose @default(CUSTOMIZABLE_BASE)
  mimeType  String              @default("image/jpeg")
  posterUrl String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, purpose, position])
}

enum ProductImagePurpose {
  COVER
  SHOWCASE
  CUSTOMIZABLE_BASE
}

enum UploadType {
  product
  avatar
  ticket
  general
  customization
}

enum UploadStatus {
  PENDING
  CONFIRMED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
}

model CartItem {
  id                  String   @id @default(cuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  sellerId            String
  quantity            Int
  unitPriceSnapshot   Decimal
  customizationIdList String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[] @relation("ProductTags")
  createdAt DateTime  @default(now())
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  translations CategoryTranslation[]
  createdAt DateTime   @default(now())

  @@index([parentId])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  locale     String
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([name])
}

model Upload {
  id         String       @id @default(cuid())
  fileName   String
  storageKey String       @unique
  mimeType   String
  size       Int
  uploadedBy String
  type       UploadType
  status     UploadStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([uploadedBy])
  @@index([type, status])
  @@index([status, createdAt]) // orphan cleanup query
}
