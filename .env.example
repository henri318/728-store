# Database (PostgreSQL via Docker on port 5433)
DATABASE_URL=postgresql://testuser:testpassword@localhost:5433/testdb

# NextAuth
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Public app URL (needed during build)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google OAuth (leave empty to disable Google login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Brevo transactional email sender
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Modular Ecommerce
BREVO_API_KEY=your-brevo-api-key

# Internal job access + email queue drain tuning
INTERNAL_JOBS_SECRET=change-me-to-a-long-random-secret
EMAIL_QUEUE_DRAIN_BATCH_SIZE=10

# Cloudflare R2 Storage
# R2_PUBLIC_BUCKET=my-public-bucket
# R2_PRIVATE_BUCKET=my-private-bucket
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_PUBLIC_DOMAIN=https://cdn.example.com
# R2_BUCKET=legacy-fallback-bucket   (fallback if R2_PUBLIC/PRIVATE_BUCKET not set)

#LocalStorage
SEED_PRODUCT_ASSET_BASE_URL=http://localhost:8081
SEED_PRODUCT_ASSET_LOCAL_STORAGE=true
GEOAPIFY_API_KEY=
